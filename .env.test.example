# Copy to .env.test.local or export in CI for Playwright + E2E.
DATABASE_URL=postgresql://...
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret
TEST_AUTH_SECRET=replace-with-random-test-secret
EXPOSE_TESTING_API=1

# Optional canonical auth origin. Preview deployments resolve their Vercel URL.
# BETTER_AUTH_URL=http://127.0.0.1:3000

# Vercel Cron Bearer token for GET /api/cron/purge-stale-fits
# CRON_SECRET=replace-with-random-secret

# Playwright
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
