# Copy to .env.test.local or export in CI for Playwright + E2E server.
# Vitest unit tests do not require these unless testing integration paths.

E2E_PLAYWRIGHT=1
E2E_ADMIN_EMAIL=e2e-admin@example.com

# Required for `next build` / production server when not using E2E_PLAYWRIGHT stub:
NEON_AUTH_BASE_URL=https://your-neon-auth-base-url
NEON_AUTH_COOKIE_SECRET=replace-with-32-plus-char-secret

# Optional: real Neon DB for integration (otherwise many routes return empty data)
# DATABASE_URL=postgresql://...

# Playwright
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
