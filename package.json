{
  "name": "project-blue-jeans",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ] && [ -z \"$GITHUB_ACTIONS\" ]; then pnpm db:migrate; fi && next build",
    "db:migrate": "tsx scripts/migrate.ts",
    "start": "next start",
    "lint": "eslint",
    "doctor": "react-doctor",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:e2e && playwright test",
    "test:e2e:ui": "pnpm build:e2e && playwright test --ui",
    "build:e2e": "EXPOSE_TESTING_API=1 next build",
    "test:instant": "playwright test e2e/instant-nav.spec.ts",
    "prepare": "test -z \"$CI\" && husky || true",
    "update-neon-branch": "tsx scripts/update-neon-branch.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.104",
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@uploadthing/react": "^7.3.3",
    "@upstash/redis": "^1.41.0",
    "ai": "^6.0.154",
    "better-auth": "^1.7.7",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@next/playwright": "^16.4.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "neonctl": "^8.0.1",
    "react-doctor": "^0.9.22",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "^1.32.0",
      "effect": "^3.20.0",
      "systeminformation": "^5.33.16",
      "undici@>=7.0.0 <7.30.1": "^7.30.1"
    }
  }
}
